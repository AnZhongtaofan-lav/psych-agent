# ============================================================
# 环境变量样例 —— 复制为 .env 后填写真实值（.env 不应提交到版本库）
# ============================================================

# ---------- LLM 配置（可插拔，不配置则系统以纯规则模式完整运行） ----------
# OpenAI 兼容接口地址（例如 https://api.openai.com/v1 或本地推理服务）
LLM_BASE_URL=
# API Key（严禁提交真实密钥到代码库）
LLM_API_KEY=
# 模型名称
LLM_MODEL=gpt-4o-mini
# LLM 读取超时（秒）
LLM_TIMEOUT_SECONDS=15

# ---------- 数据库 ----------
# SQLite 数据库文件路径（生产环境建议迁移 PostgreSQL 并启用行级加密）
DB_PATH=./data/psych.db

# ---------- 服务 ----------
# 日志级别：DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# ---------- 危机干预热线（可按地区覆盖） ----------
# 全国统一心理援助热线
CRISIS_HOTLINE_PRIMARY=12356
# 备用热线（示例：北京心理危机研究与干预中心）
CRISIS_HOTLINE_SECONDARY=010-82951332
# 紧急医疗电话（L3 连续高危升级时提示）
EMERGENCY_NUMBER=120
