{
  "_comment": [
    "风险词典 —— 四级风险分级的数据源（由 core/risk/risk_rules.py 加载）",
    "匹配对象：normalizer.normalize() 之后的文本（已做全角归一/小写/谐音映射/去插空）",
    "安全原则：词典宁可多收（误报）不可漏收（漏报）；新增变体时同步更新 normalizer 的上下文映射表",
    "levels 结构：1=关注(L1) / 2=高风险(L2) / 3=危机(L3，触发强制拦截)",
    "每个 level 下按语义分组：keywords 为子串匹配，regexes 为正则匹配（在归一化文本上执行）"
  ],
  "version": "1.0",
  "levels": {
    "1": {
      "label": "关注",
      "groups": [
        {
          "group": "情绪低落",
          "keywords": [
            "难受", "委屈", "撑不住", "emo", "心累", "烦死了", "好累",
            "压力好大", "压力太大", "想哭", "不开心", "难过", "郁闷",
            "低落", "丧", "崩溃", "睡不着", "失眠", "没胃口"
          ],
          "regexes": [
            "压(得|的)我喘不过气",
            "(心里|感觉)不(是|好)(滋味|受)"
          ]
        }
      ]
    },
    "2": {
      "label": "高风险",
      "groups": [
        {
          "group": "绝望",
          "keywords": [
            "没有意义", "没意义", "绝望", "都是我的错", "全是我的错",
            "活得很累", "活着好累", "一切都完了", "全完了", "看不到希望",
            "没有希望", "没指望了", "无力回天", "自责"
          ],
          "regexes": [
            "(什么|一切|所有)(都|也)?没有(任何)?(意义|希望)",
            "活(着|了)?没(什么)?(意思|意义)",
            "(我)?怎么努力都(没有|没用)"
          ]
        },
        {
          "group": "自伤倾向",
          "keywords": [
            "伤害自己", "掐自己", "想消失", "厌恶自己", "恨自己",
            "惩罚自己", "折磨自己", "想从这个世界上消失"
          ],
          "regexes": [
            "想(要)?消失",
            "伤害(一?下)?自己",
            "(狠狠)?惩罚自己"
          ]
        }
      ]
    },
    "3": {
      "label": "危机",
      "groups": [
        {
          "group": "自杀意念",
          "keywords": [
            "自杀", "轻生", "不想活", "想死", "了结", "结束生命",
            "结束自己", "活不下去", "不想活了", "寻死", "求死",
            "了结自己", "告别这个世界"
          ],
          "regexes": [
            "(不想|不愿)再?活(着|了|下去)?",
            "想(去|要)?死",
            "(了|理)结?自己",
            "结束(自己的)?生命",
            "活(着|下去)?(真的)?(太|好)?(累|难)(了)?，?(不如|宁可)?死"
          ]
        },
        {
          "group": "自伤行为",
          "keywords": [
            "割腕", "自残", "自伤", "划手臂", "划胳膊"
          ],
          "regexes": [
            "割(腕|手腕|手)",
            "(用|拿)?(刀|刀片|美工刀)(划|割)(自己|手腕|手臂|胳膊)",
            "掐(自己|脖子|大腿)",
            "(抓|抠|咬)(伤)?自己"
          ]
        },
        {
          "group": "计划工具",
          "keywords": [
            "安眠药", "跳楼", "烧炭", "上吊", "跳桥", "跳河", "农药", "敌敌畏"
          ],
          "regexes": [
            "(吃|服|吞|囤)(下|了)?(安眠药|药|药片)",
            "(安眠药|药片?).{0,8}(片|粒|盒|瓶)",
            "跳(楼|桥|河|江|海)",
            "烧炭|上吊",
            "(买|备|准备)了?(药|刀|绳子|炭)"
          ]
        }
      ]
    }
  }
}
